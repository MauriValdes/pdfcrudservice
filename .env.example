# ============================================================
# Configuración de MongoDB
# ============================================================

# Credenciales para inicializar el contenedor MongoDB
MONGO_INITDB_ROOT_USERNAME=usuario
MONGO_INITDB_ROOT_PASSWORD=contraseña

# Conexión local desde la aplicación (fuera de Docker)
MONGO_URL=mongodb://usuario:contraseña@localhost:27017

# Base de datos y colección utilizadas por MS3
MONGO_DB_DEV=pdf_database_dev
MONGO_COLLECTION=processed_pdfs

# Tamaño máximo permitido para archivos PDF (MB)
MAX_FILE_SIZE_MB=5

# ============================================================
# Configuración de Integración MS2
# ============================================================

EXTRACT_SERVICE_URL=http://localhost:8002
EXTRACT_SERVICE_TIMEOUT=30

# ============================================================
# Configuración de Docker Compose
# ============================================================

MONGO_PORT=27017
APP_PORT=8000
TRAEFIK_DASHBOARD_PORT=8081